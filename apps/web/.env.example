# Neon: pooled for the app, direct for migrations
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional for the web MVP (oEmbed is used without it); needed for search and AI checks
YOUTUBE_API_KEY=""
ANTHROPIC_API_KEY=""
# Firebase service account JSON, on one line
FIREBASE_SERVICE_ACCOUNT='{"project_id":"...","client_email":"...","private_key":"..."}'

# Auth.js
AUTH_SECRET=""          # npx auth secret
# Optional: shows "Sign in with Google"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Protects /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=""
